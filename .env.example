# Mini runtime: private state outside the checkout.
CONSOLE_DATA_DIR=/Users/agent001/workspace-agent/deploy/ai-tv-pet-console/state
CONSOLE_ORIGIN=https://car.aimaker.vip
# Development HTTP is allowed only on loopback, never for Pi transport.
CONSOLE_DEV_HTTP=0
# Optional local faster-whisper model directory. No external audio upload.
CONSOLE_ASR_MODEL=
# Reuse the Mini's existing family recognition service; empty disables recognition.
CONSOLE_FACE_SERVICE_URL=http://127.0.0.1:8000

# Explicit local-only review capture; empty means disabled. Never point at web/static folders.
# Enabled capture saves people only, at least 30 seconds apart, up to 50 per Asia/Singapore day.
# The persistent daily quota survives restarts and photo/label deletion; capture resumes at 00:00.
CONSOLE_POSE_REVIEW_DIR=
CONSOLE_POSE_REVIEW_FONT=
